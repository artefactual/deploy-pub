# Settings for running the suite against the Docker Compose development stack
# of the Archivematica repository (hack/docker-compose.yml). Load them with:
#
#     set -a; source hack-stack.env; set +a
#
RT_AM_URL=http://127.0.0.1:62080
RT_AM_USER=test
RT_AM_PASSWORD=test
RT_AM_API_KEY=test
RT_SS_URL=http://127.0.0.1:62081
RT_SS_USER=test
RT_SS_API_KEY=test
RT_SS_PASSWORD=test
RT_TRANSFER_SOURCE_ROOT=/home/archivematica/archivematica-sampledata
RT_COMPOSE_COMMAND="docker compose"
RT_COMPOSE_DIR=~/dev/archivematica/hack
RT_PIPELINE_SERVICE=archivematica-storage-service
RT_PIPELINE_USER=-
# ImageMagick, which the manual normalization scenarios run, is in the MCP
# client image and not in the Storage Service one.
RT_TOOLS_SERVICE=archivematica-mcp-client
RT_MAIL_DIR=
RT_LOG_SERVICES=archivematica-mcp-server,archivematica-mcp-client,archivematica-dashboard,archivematica-storage-service
RT_OS_LABEL=hack
