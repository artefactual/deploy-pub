#!/usr/bin/env bash

set -euo pipefail

container_output=false
if [[ ${1:-} == "--container-output" ]]; then
    container_output=true
    shift
fi

if [[ $# -ne 3 ]]; then
    echo "Usage: $0 [--container-output] SERVICE UNIT OUTPUT" >&2
    exit 2
fi

service=$1
unit=$2
output=$3

if "$container_output"; then
    podman-compose exec --user root "$service" sh -c \
        'mkdir -p "$(dirname "$2")" && journalctl -u "$1" --no-pager > "$2"' \
        sh "$unit" "$output"
else
    mkdir -p "$(dirname "$output")"
    podman-compose exec --user root "$service" \
        journalctl -u "$unit" --no-pager > "$output"
fi
